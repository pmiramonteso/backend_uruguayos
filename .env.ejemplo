# Entorno: development (arranca el servidor con app.listen) o production (cPanel/Passenger)
NODE_ENV=development
PORT=3000

# Base de datos MySQL
HOST_NAME=localhost
DATABASE=proj_uruguayos
USER_NAME=su_usuario
PASSWORD=su_contraseña

# Autenticación
JWT_SECRET=rellenar_con_secreto_jwt
BCRYPT_SALT=10

# URL del frontend (enlaces de los emails de recuperar contraseña)
USER_URL=http://localhost:4200

# Opcional: orígenes permitidos por CORS, separados por comas
# (por defecto: https://uruguayosenespanya.com y localhost:4200)
# CORS_ORIGINS=https://staging.uruguayosenespanya.com

# Opcional: carpeta con el frontend compilado
# (por defecto: ../../public_html respecto a src/)
# PUBLIC_DIR=/home/usuario/staging.uruguayosenespanya.com

# Email (recuperar contraseña)
EMAIL_HOST=
EMAIL_USERNAME=
EMAIL_PASSWORD=
FROM_EMAIL=
